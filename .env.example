# Supabase project (Project settings > API). The service role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in unsubscribe links and the Google redirect URL.
APP_URL=https://your-app.vercel.app

# Shared team password for signing in, and two secrets: any long random strings (30+ characters, all different).
APP_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
# Optional. The scheduler secret normally lives only in Supabase Vault (see supabase/scheduler.sql).
CRON_SECRET=

# Google Cloud OAuth client (Web application) from the Phase 0 checklist. Use "pending" until it exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification: millionverifier or zerobounce. Without these, unverified leads wait and are never emailed.
VERIFIER=millionverifier
VERIFIER_API_KEY=
